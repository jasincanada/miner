# Call Recorder — environment template.
# Copy to `.env` ON THE EPYC ONLY and fill in real values there.
# Secrets never live in git and never in a release (DEPLOY.md,
# Delivery model). This file names every variable the stack needs.

# --- Postgres (db service; also composed into the api DATABASE_URL) ---
POSTGRES_USER=callrecorder
# Long random string. Generate on the EPYC, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me-generate-a-long-random-value
POSTGRES_DB=callrecorder

# --- Release channel / images ---
# Which published channel this machine runs: main (stable, the EPYC
# default), beta, or alpha — or a pinned version tag like 1.2.0.
IMAGE_TAG=main
# Host port the web container binds on localhost (front nginx proxies
# callrecorder.cryptocomputer.ca here).
WEB_PORT=8080

# --- API ---
LOG_LEVEL=info
# Keep true in production: session cookies only travel over HTTPS.
# (Set false only for local plain-HTTP development.)
COOKIE_SECURE=true
SESSION_TTL_DAYS=30

# --- One-time account creation (not used by any running service) ---
# Used once, by hand, to create Jas's login:
#   SEED_USERNAME=… SEED_PASSWORD=… docker compose run --rm api npm run create-user
# Jas chooses the password himself; do not leave real values in this
# file or in the filled-in .env after the account exists.
SEED_USERNAME=
SEED_PASSWORD=
