# syntax=docker/dockerfile:1
# Call Recorder API — multi-stage. The same image runs the server
# (default CMD), the one-shot migrate service (node dist/migrate.js),
# and the one-time create-user script.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json drizzle.config.ts ./
COPY src ./src
RUN npm run build
# Generate no SQL here — migrations are generated by drizzle-kit in
# the repo and committed (see ./drizzle); copy them into the image.
COPY drizzle ./drizzle

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/drizzle ./drizzle
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]
